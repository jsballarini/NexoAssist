# --- Perfil: local dev (padrão) | CI | demo LLM ---
# Local: copie para `.env`; CI usa os mesmos nomes no GitHub Actions / Playwright.

DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexo

# Demo LLM: preencha e defina AGENT_EVAL_FIXTURES=false
# O agent usa tool calling: escolha um modelo com suporte (ex.: openai/gpt-4o-mini).
# Modelos gratuitos costumam não suportar tools e resultam em "assistente indisponível".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Opcional; default https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Agent (opcionais; defaults entre parênteses)
# Últimas N mensagens enviadas ao modelo (20)
AGENT_HISTORY_MAX_MESSAGES=20
# Máximo de passos de tool calling por turno (5)
AGENT_MAX_STEPS=5
# Tokens máximos de saída por passo (1024)
AGENT_MAX_OUTPUT_TOKENS=1024
# Timeout da chamada ao LLM em ms (45000)
AGENT_LLM_TIMEOUT_MS=45000

# Obrigatório (≥32 caracteres) — CI injeta valor fixo no workflow
SESSION_SECRET=

LLM_MAX_CONCURRENCY=2
AGENT_CONFIDENCE_TRANSFER_OFFER=50
AGENT_CONFIDENCE_TRANSFER_STRONG=35

# Local: pode >0 para chaos manual; CI/E2E usam 0
TICKET_CHAOS_RATE=0.03

# Retry do agent ao legado de chamados (a API HTTP não faz retry)
TICKET_RETRY_ATTEMPTS=3
TICKET_RETRY_BACKOFF_MS=1000,2000,4000
TICKET_RETRY_TURN_BUDGET_MS=6000

# E2E local e job `e2e` no GHA: true (desabilita rate limit agressivo)
CHAOS_ENDPOINT_ENABLED=false

TEST_USE_WALL_CLOCK=false
ANALYST_POLL_INTERVAL_MS=3000
ANALYST_POLL_BACKGROUND_MS=10000
ANALYST_THREAD_POLL_MS=2000
PROXY_API_RATE_LIMIT_PER_MIN=180
EMPLOYEE_HANDOFF_POLL_MS=4000

# E2E (`npm run test:e2e`): o Playwright define NEXT_DIST_DIR=.next-playwright no webServer.
# Não defina NEXT_DIST_DIR aqui no dev manual (default .next na porta 3000).

# CI / E2E / onboarding sem OpenRouter: true (determinístico)
# Demo entrevista com LLM real: false + OPENROUTER_*
AGENT_EVAL_FIXTURES=true
# Evals com o modelo real (`npm run test:evals:llm`): usa OPENROUTER_* acima.
# Piso de acurácia global da matriz de frases (0-1); opcional.
# EVAL_LLM_MIN_ACCURACY=0.7
