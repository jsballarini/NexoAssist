# --- Perfil: local dev (padrão) | CI | demo LLM ---
# Local: copie para `.env`; CI usa os mesmos nomes no GitHub Actions / Playwright.

DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexo

# Demo LLM: preencha e defina AGENT_EVAL_FIXTURES=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Obrigatório (≥32 caracteres) — CI injeta valor fixo no workflow
SESSION_SECRET=

LLM_MAX_CONCURRENCY=2
AGENT_CONFIDENCE_TRANSFER_OFFER=50
AGENT_CONFIDENCE_TRANSFER_STRONG=35

# Local: pode >0 para chaos manual; CI/E2E usam 0
TICKET_CHAOS_RATE=0.03

# E2E local e job `e2e` no GHA: true (desabilita rate limit agressivo)
CHAOS_ENDPOINT_ENABLED=false

TEST_USE_WALL_CLOCK=false
ANALYST_POLL_INTERVAL_MS=3000
ANALYST_POLL_BACKGROUND_MS=10000
ANALYST_THREAD_POLL_MS=2000
PROXY_API_RATE_LIMIT_PER_MIN=60

# CI / E2E / onboarding sem OpenRouter: true (determinístico)
# Demo entrevista com LLM real: false + OPENROUTER_*
AGENT_EVAL_FIXTURES=true